/* ---- the Finder and MultiFinder ---- */

#include "icons.r"
#include "balloons.r"

/* Topica opens and owns text files: its own posts get the post icon */
resource 'FREF' (128) { 'APPL', 0, "" };
resource 'FREF' (129) { 'TEXT', 1, "" };

resource 'BNDL' (128) {
	'TPCA', 0,
	{
		'ICN#', { 0, 128; 1, 129 };
		'FREF', { 0, 128; 1, 129 };
	}
};

/* The signature (owner) resource */
data 'TPCA' (0, "Owner resource") {
	$"06" "Topica"
};

resource 'vers' (1) {
	@TOPICA_VERS_MAJOR@, @TOPICA_VERS_MINOR@, development, 0, verUS,
	"@TOPICA_VERSION_DISPLAY@",
	"@TOPICA_VERSION_DISPLAY@, \251 2026 Topica contributors"
};

/* Apple-event aware on System 7 (ae.c); System 6 hands over documents
   through CountAppFiles, which main.c reads. */
resource 'SIZE' (-1) {
	reserved,
	acceptSuspendResumeEvents,
	reserved,
	canBackground,
	doesActivateOnFGSwitch,
	backgroundAndForeground,
	dontGetFrontClicks,
	ignoreChildDiedEvents,
	is32BitCompatible,
	isHighLevelEventAware,
	onlyLocalHLEvents,
	isStationeryAware,
	dontUseTextEditServices,
	reserved,
	reserved,
	reserved,
	@TOPICA_SIZE_PREFERRED@ * 1024,
	@TOPICA_SIZE_MINIMUM@ * 1024
};

resource 'DLOG' (146, "Publish", purgeable) {
