/* Topica: resources (Rez). CMake fills in the @...@ values. */
#include "Processes.r"
#include "Menus.r"
#include "Windows.r"
#include "Dialogs.r"
#include "MacTypes.r"

resource 'MBAR' (128) {
	{ 128, 129, 130, 131 };
};

/* Enable flags: bit 0 is item 1 (the menu's own flag is the "enabled" after
   them). Separators are disabled; in the Apple menu the desk accessories
   after the separator stay enabled. */
resource 'MENU' (128, "Apple") {
	128, textMenuProc, 0x7FFFFFFD, enabled, apple,
	{
		"About Topica\311", noIcon, noKey, noMark, plain;
		"-", noIcon, noKey, noMark, plain
	}
};

resource 'MENU' (129, "File") {
	129, textMenuProc, 0x17B, enabled, "File",
	{
		"New Post", noIcon, "N", noMark, plain;
		"Open\311", noIcon, "O", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Close", noIcon, "W", noMark, plain;
		"Save", noIcon, "S", noMark, plain;
		"Save As\311", noIcon, noKey, noMark, plain;
		"Revert", noIcon, noKey, noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Quit", noIcon, "Q", noMark, plain
	}
};

/* Redo is Command-Shift-Z, which a menu can't show: main.c handles it. */
resource 'MENU' (130, "Edit") {
	130, textMenuProc, 0x5D7B, enabled, "Edit",
	{
		"Undo", noIcon, "Z", noMark, plain;
		"Redo", noIcon, noKey, noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Cut", noIcon, "X", noMark, plain;
		"Copy", noIcon, "C", noMark, plain;
		"Paste", noIcon, "V", noMark, plain;
		"Clear", noIcon, noKey, noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Select All", noIcon, "A", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Find\311", noIcon, "F", noMark, plain;
		"Find Again", noIcon, "G", noMark, plain;
		"Replace & Find Again", noIcon, "=", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Preferences\311", noIcon, noKey, noMark, plain
	}
};

resource 'MENU' (131, "Post") {
	131, textMenuProc, 0x5, enabled, "Post",
	{
		"Post Info\311", noIcon, "E", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Insert Image\311", noIcon, noKey, noMark, plain
	}
};

/* ---- alerts ---- */

/* Alert rectangles are where System 6 puts them, centred on a 512x342
   screen; System 7 centres them on any screen (alertPositionMainScreen). */
resource 'ALRT' (128, "About", purgeable) {
	{ 77, 86, 227, 426 }, 128,
	{
		OK, visible, silent;
		OK, visible, silent;
		OK, visible, silent;
		OK, visible, silent;
	},
	alertPositionMainScreen
};

resource 'DITL' (128, "About", purgeable) {
	{
		{ 116, 256, 136, 324 }, Button { enabled, "OK" };
		{ 12, 16, 32, 324 }, StaticText { disabled, "Topica @TOPICA_VERSION_DISPLAY@" };
		{ 38, 16, 108, 324 }, StaticText { disabled,
			"A Markdown writer for blogs.\r"
			"Named for Aristotle\325s Topics, on finding things to say.\r"
			"\251 2026 Topica contributors" };
	}
};

resource 'ALRT' (129, "Save Changes", purgeable) {
	{ 88, 82, 204, 430 }, 129,
	{
		OK, visible, sound1;
		OK, visible, sound1;
		OK, visible, sound1;
		OK, visible, sound1;
	},
	alertPositionMainScreen
};

resource 'DITL' (129, "Save Changes", purgeable) {
	{
		{ 84, 266, 104, 334 }, Button { enabled, "Save" };
		{ 84, 186, 104, 254 }, Button { enabled, "Cancel" };
		{ 84, 16, 104, 104 }, Button { enabled, "Don\325t Save" };
		{ 12, 60, 72, 334 }, StaticText { disabled, "Save changes to \322^0\323 before ^1?" };
	}
};

resource 'ALRT' (130, "Message", purgeable) {
	{ 87, 82, 207, 430 }, 130,
	{
		OK, visible, sound1;
		OK, visible, sound1;
		OK, visible, sound1;
		OK, visible, sound1;
	},
	alertPositionMainScreen
};

resource 'DITL' (130, "Message", purgeable) {
	{
		{ 88, 266, 108, 334 }, Button { enabled, "OK" };
		{ 12, 60, 80, 334 }, StaticText { disabled, "^0" };
	}
};

resource 'ALRT' (131, "Revert", purgeable) {
	{ 88, 82, 204, 430 }, 131,
	{
		OK, visible, sound1;
		OK, visible, sound1;
		OK, visible, sound1;
		OK, visible, sound1;
	},
	alertPositionMainScreen
};

resource 'DITL' (131, "Revert", purgeable) {
	{
		{ 84, 266, 104, 334 }, Button { enabled, "Revert" };
		{ 84, 186, 104, 254 }, Button { enabled, "Cancel" };
		{ 12, 60, 72, 334 }, StaticText { disabled,
			"Revert to the last saved version of \322^0\323? Your changes will be lost." };
	}
};

